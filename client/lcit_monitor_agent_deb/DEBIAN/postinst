#!/bin/bash
set -e

# Lấy hostname và platform từ biến môi trường
: "${HOSTNAME:=default_host}"
: "${PLATFORM:=default_platform}"

# Copy file thực thi
mkdir -p /usr/local/bin
cp /usr/local/bin/lcit-monitor-agent /usr/local/bin/
chmod 755 /usr/local/bin/lcit-monitor-agent

# Tạo systemd service với tham số
cat > /etc/systemd/system/lcit-monitor-agent.service <<EOL
[Unit]
Description=LCIT System Monitor
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lcit-monitor-agent --hostname $HOSTNAME --platform $PLATFORM
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
EOL

# Reload systemd và enable service
systemctl daemon-reload
systemctl enable lcit-monitor-agent
systemctl start lcit-monitor-agent
exit 0
